[Unit]
Description=Telegram Codex Controller
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/telegram-codex-controller
EnvironmentFile=/opt/telegram-codex-controller/.env
ExecStart=/opt/telegram-codex-controller/.venv/bin/python -m telegram_codex_controller.main
Restart=always
RestartSec=5
User=youruser

[Install]
WantedBy=multi-user.target
