[Unit]
Description=Pocket Operator
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/pocket-operator
EnvironmentFile=/opt/pocket-operator/.env
ExecStart=/opt/pocket-operator/.venv/bin/python -m pocket_operator.main
Restart=always
RestartSec=5
User=youruser

[Install]
WantedBy=multi-user.target
