<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.linfwang.telegram-codex-controller</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-lc</string>
        <string>cd /Users/linfwang/repo/telegram-codex-controller && source .venv/bin/activate && export PYTHONPATH=/Users/linfwang/repo/telegram-codex-controller/src:${PYTHONPATH:-} && python -m telegram_codex_controller.main</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/linfwang/repo/telegram-codex-controller</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/linfwang/repo/telegram-codex-controller/logs/stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/linfwang/repo/telegram-codex-controller/logs/stderr.log</string>
</dict>
</plist>
